# Copy to .env (git-ignored). Dev defaults only — change every secret for shared/pilot use.

# ── PostgreSQL ──
POSTGRES_USER=smriti
POSTGRES_PASSWORD=smriti
POSTGRES_DB=smriti
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── S3-compatible object storage (SeaweedFS) ──
S3_ACCESS_KEY=smriti
S3_SECRET_KEY=smriti-secret
S3_PORT=8333

# ── API ──
API_PORT=8000
SMRITI_ENV=dev
SMRITI_LOG_LEVEL=INFO
SMRITI_LOG_JSON=true
SMRITI_AUTH_MODE=dev
SMRITI_S3_BUCKET_RAW=smriti-raw
SMRITI_S3_BUCKET_PAGES=smriti-pages
