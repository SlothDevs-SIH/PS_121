# Copy to .env (git-ignored). Dev defaults only — change every secret for shared/pilot use.

# ── PostgreSQL ──
POSTGRES_USER=smriti
POSTGRES_PASSWORD=smriti
POSTGRES_DB=smriti
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── S3-compatible object storage (SeaweedFS) ──
S3_ACCESS_KEY=smriti
S3_SECRET_KEY=smriti-secret
S3_PORT=8333

# ── Web app (nginx) ──
WEB_PORT=8080
# Map basemap. Empty = no tiles (offline / air-gapped). For online OpenStreetMap tiles:
#   MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   MAP_TILE_ATTRIBUTION=(c) OpenStreetMap contributors
#   MAP_TILE_ORIGIN=https://tile.openstreetmap.org
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_ORIGIN=

# ── API ──
API_PORT=8000
SMRITI_ENV=dev
SMRITI_LOG_LEVEL=INFO
SMRITI_LOG_JSON=true
SMRITI_AUTH_MODE=dev
SMRITI_S3_BUCKET_RAW=smriti-raw
SMRITI_S3_BUCKET_PAGES=smriti-pages

# ── Extraction (B2). Rules always run; the LLM pass is optional and off by default ──
# OpenAI-compatible endpoint (Ollama / vLLM), e.g. http://localhost:11434/v1
# SMRITI_LLM_BASE_URL=
# SMRITI_LLM_MODEL=qwen2.5:7b-instruct
# SMRITI_LLM_TIMEOUT_S=60
# SMRITI_EXTRACT_LLM_ENABLED=false
# Record-level confidence below which an extraction goes to the review queue
# SMRITI_EXTRACT_CONFIDENCE_THRESHOLD=0.75

# ── Search (B2) ──
# hash = deterministic 1024-d feature hashing (offline / CI); ollama = EMBEDDING_MODEL via Ollama
# SMRITI_EMBEDDING_PROVIDER=hash
# SMRITI_EMBEDDING_MODEL=bge-m3
# SMRITI_EMBEDDING_BASE_URL=http://localhost:11434
# Optional cross-encoder rerank endpoint; unset = RRF fusion only
# SMRITI_RERANKER_URL=
